// Bell EQ for RNBO codebox~
//
// Paste this entire file into a codebox~ object.
// in1  : input signal
// out1 : filtered signal

@param({ min: 20, max: 20000 }) frequency = 1000;
@param({ min: -18, max: 18 }) gainDb = 6;
@param({ min: 0.1, max: 10 }) q = 1;

@state bellFilter = new biquad();

function peakingCoefficients(frequency, gainDb, q)
{
    let amplitude = pow(10, gainDb / 40);
    let omega0 = 2 * pi * frequency / samplerate;
    let alpha = sin(omega0) / (2 * q);
    let cosine = cos(omega0);

    // Normalize by the cookbook denominator coefficient a0.
    let denominator0 = 1 + alpha / amplitude;

    let feedforward0 = (1 + alpha * amplitude) / denominator0;
    let feedforward1 = (-2 * cosine) / denominator0;
    let feedforward2 = (1 - alpha * amplitude) / denominator0;
    let feedback1 = (-2 * cosine) / denominator0;
    let feedback2 = (1 - alpha / amplitude) / denominator0;

    return [
        feedforward0,
        feedforward1,
        feedforward2,
        feedback1,
        feedback2
    ];
}

let coefficients = peakingCoefficients(frequency, gainDb, q);

// RNBO's names are a0/a1/a2 for feedforward and b1/b2 for feedback.
out1 = bellFilter.next(
    in1,
    coefficients[0],
    coefficients[1],
    coefficients[2],
    coefficients[3],
    coefficients[4]
);
